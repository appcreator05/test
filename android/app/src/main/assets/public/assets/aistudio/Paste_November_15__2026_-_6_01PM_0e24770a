<!-- Firebase SDKs -->
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>

<script>
let dbCache;
let homeCachedHTML = "";
let isUserSubscribed = false; 
const memoryImageCache = {};

const openDB = () => {
    return new Promise((resolve, reject) => {
        if (dbCache) return resolve();
        const request = indexedDB.open("MoviePosterDB", 1);
        request.onupgradeneeded = (e) => {
            let db = e.target.result;
            if (!db.objectStoreNames.contains("images")) {
                db.createObjectStore("images");
            }
        };
        request.onsuccess = (e) => {
            dbCache = e.target.result;
            resolve();
        };
        request.onerror = reject;
    });
};

async function getCachedImage(url) {
    return new Promise((resolve) => {
        if (!dbCache) return resolve(null);
        const tx = dbCache.transaction("images", "readonly");
        const store = tx.objectStore("images");
        const req = store.get(url);
        req.onsuccess = () => {
            if (req.result) {
                resolve(URL.createObjectURL(req.result));
            } else {
                resolve(null);
            }
        };
        req.onerror = () => resolve(null);
    });
}

async function saveImage(url) {
    try {
        const response = await fetch(url, { mode: 'cors' });
        if (!response.ok) return url;
        const blob = await response.blob();
        const tx = dbCache.transaction("images", "readwrite");
        const store = tx.objectStore("images");
        store.put(blob, url);
        return URL.createObjectURL(blob);
    } catch {
        return url;
    }
}

async function getImage(url) {
    if (!url) return '';
    if (memoryImageCache[url]) {
        return memoryImageCache[url];
    }
    const cached = await getCachedImage(url);
    if (cached) {
        memoryImageCache[url] = cached;
        return cached;
    }
    const saved = await saveImage(url);
    if (saved) {
        memoryImageCache[url] = saved;
    }
    return saved;
}

const firebaseConfig = { databaseURL: "https://myapps-4a8eb-default-rtdb.firebaseio.com" };
if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
}
const db = firebase.database();

function getDeviceId(){
    let id = localStorage.getItem("device_id");
    if(!id){
        id = "dev_" + Math.random().toString(36).substr(2,12);
        localStorage.setItem("device_id", id);
    }
    return id;
}
const DEVICE_ID = getDeviceId();

async function checkSubscriptionBackground() {
    try {
        const subRef = db.ref("subscriptions").orderByChild("device_id").equalTo(DEVICE_ID);
        subRef.once("value", (snap) => {
            const data = snap.val();
            if (data) {
                const now = Date.now();
                for (const id in data) {
                    const sub = data[id];
                    if (sub.expireAt && now > sub.expireAt) {
                        db.ref("subscriptions/" + id).remove();
                        continue;
                    }
                    if (sub.used) {
                        isUserSubscribed = true;
                        break;
                    }
                }
            }
        });
    } catch (err) {
        console.error("Subscription check error:", err);
    }
}

let allMovies = [], currentCategory = "all"; 
let isInCategoryView = false;

async function fetchMovies() {
    try {
        await openDB();
        const response = await fetch(
            "https://cdn.jsdelivr.net/gh/appcreator05/post@main/app.json", 
            { cache: "no-store" }
        );
        allMovies = await response.json();

        setTimeout(() => {
            renderContent(allMovies);
        }, 50);

    } catch (err) {
    console.error(err);
    document.getElementById("mainContainer").innerHTML = `
        <div style='grid-column:1/-1;text-align:center;padding:40px;'>
            Failed to load movies! 
            <button onclick="window.location='go:hometest'" style='padding:8px 15px;background:#00d2ff;border:none;border-radius:5px;cursor:pointer;font-weight:bold;'>Retry</button>
        </div>
    `;
}
}

function filterMovies(category) {
    currentCategory = category;
    window.scrollTo(0, 0);

    if (category === 'all') {
        isInCategoryView = false;
        updateMenuButtonState();
        const container = document.getElementById('mainContainer');
        
        if (homeCachedHTML) {
            container.innerHTML = homeCachedHTML;
            container.querySelectorAll('img[data-src]').forEach(img => imageObserver.observe(img));
        } else {
            renderContent(allMovies);
        }
    } else {
        isInCategoryView = true;
        updateMenuButtonState();
        const matched = allMovies.filter(m => m.category === category);
        const container = document.getElementById('mainContainer');
        container.innerHTML = `
            <div class="section-header">
                <div class="section-title-wrapper">
                    <div class="section-bar"></div>
                    <div class="section-title">${category}</div>
                </div>
            </div>
            <div class="gallery-grid" id="movieGallery"></div>
        `;
        const gallery = document.getElementById('movieGallery');
        matched.length === 0 ? gallery.innerHTML = "<div style='grid-column:1/-1;text-align:center;padding:30px;color:#888;'>No movies found!</div>" : matched.forEach(m => renderCard(m, gallery));
    }
}

function updateMenuButtonState() {
    const icon = document.getElementById('menuIcon');
    const text = document.getElementById('menuBtnText');
    if (isInCategoryView) {
        icon.className = "fa-solid fa-arrow-left";
        text.innerText = "Back";
    } else {
        icon.className = "fa-solid fa-bars";
        text.innerText = "Menu";
    }
}

function handleMenuBtnClick() {
    if (isInCategoryView) {
        filterMovies('all');
    } else {
        toggleSidebar();
    }
}

function handleSearch() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
    if (!searchTerm) {
        if (currentCategory === 'all') {
            filterMovies('all');
        } else {
            filterMovies(currentCategory);
        }
        return;
    }

    isInCategoryView = true;
    updateMenuButtonState();
    window.scrollTo(0, 0);

    const matched = allMovies.filter(m => {
        const titleMatch = m.title && m.title.toLowerCase().includes(searchTerm);
        const castMatch = m.cast && m.cast.toLowerCase().includes(searchTerm);
        return titleMatch || castMatch;
    });

    const container = document.getElementById('mainContainer');
    container.innerHTML = `
        <div class="section-header">
            <div class="section-title-wrapper">
                <div class="section-bar"></div>
                <div class="section-title">Search Results</div>
            </div>
        </div>
        <div class="gallery-grid" id="movieGallery"></div>
    `;
    const gallery = document.getElementById('movieGallery');
    if (matched.length === 0) {
        gallery.innerHTML = "<div style='grid-column:1/-1;text-align:center;padding:30px;color:#888;'>No movies found!</div>";
    } else {
        matched.forEach(m => renderCard(m, gallery));
    }
}

// --- Continue Watching History Logic ---
function addToContinueWatching(movie) {
    let history = JSON.parse(localStorage.getItem('continue_watching') || '[]');
    // ইতিমধ্যে লিস্টে থাকলে তা সরিয়ে ফেলা যাতে নতুন করে শীর্ষে যোগ করা যায়
    history = history.filter(item => item.link !== movie.link);
    // নতুন মুভিটি শুরুতে যোগ করা
    history.unshift(movie);
    // সর্বোচ্চ ১০টি আইটেম রাখা
    if (history.length > 10) {
        history = history.slice(0, 10);
    }
    localStorage.setItem('continue_watching', JSON.stringify(history));
}

// --- Subscription Popup Logic & Post Click Handler ---
window.handleMovieClick = function(movieObj) {
    // Continue Watching-এ যুক্ত করা
    addToContinueWatching(movieObj);

    if (!isUserSubscribed) {
        document.getElementById('subModalOverlay').style.display = 'flex';
    } else {
        showOverlay(movieObj.link);
    }
}

window.closeSubModal = function() {
    document.getElementById('subModalOverlay').style.display = 'none';
}

window.handleSubscribeNow = function() {
    window.location.href = "go:sub2";
}

function showOverlay(link) {
    const overlay = document.createElement('div');
    overlay.id = "temp-overlay";
    overlay.style.cssText = "position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); display:flex; justify-content:center; align-items:center; z-index:99999; color:#fff; font-size:20px;";
    overlay.innerHTML = "Please Wait...";
    document.body.appendChild(overlay);

    setTimeout(() => {
        window.location.href = link;
    }, 1000);

    setTimeout(() => {
        const el = document.getElementById("temp-overlay");
        if (el) el.remove();
    }, 5000);
}

// --- Voice Search Function ---
function startVoiceSearch() {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        alert("Voice search is not supported in your browser!");
        return;
    }

    const recognition = new SpeechRecognition();
    recognition.lang = 'en-US';
    const micBtn = document.getElementById('micBtn');

    recognition.onstart = function() {
        micBtn.classList.add('listening');
    };

    recognition.onresult = function(event) {
        const speechToText = event.results[0][0].transcript;
        document.getElementById('searchInput').value = speechToText;
        handleSearch();
    };

    recognition.onerror = function() {
        micBtn.classList.remove('listening');
    };

    recognition.onend = function() {
        micBtn.classList.remove('listening');
    };

    recognition.start();
}

// মোবাইল ডিভাইসের জন্য সাইডবার টগল ফাংশন
function toggleSidebar() { 
    if (window.innerWidth > 768) return; 
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("sidebarOverlay");
    
    sidebar.classList.toggle("active");
    overlay.classList.toggle("active");
}

const imageObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            const img = entry.target;
            observer.unobserve(img);
           
            getImage(img.dataset.src).then((cachedSrc) => {
                img.src = cachedSrc;
                img.onload = () => {
                    img.classList.add("loaded");
                };
            });
        }
    });
}, {
    root: null,
    rootMargin: "200px 0px",
    threshold: 0
});

function renderCard(m, container) {
    const card = document.createElement('div');
    card.className = 'movie-card';
    card.onclick = () => handleMovieClick(m); // পুরো মুভি অবজেক্ট পাস করা হচ্ছে

    card.innerHTML = `
        <span class="rating-badge">★ ${m.rating || '0.0'}</span>
        <img data-src="${m.poster}">
        <div class="movie-title-container">
            <div class="movie-title">${m.title}</div>
        </div>
    `;

    container.appendChild(card);
    const img = card.querySelector("img");
    imageObserver.observe(img);
}

function renderContent(movies) {
    const container = document.getElementById('mainContainer');
    container.innerHTML = "";

    // ১. প্রথমে Continue Watching সেকশন রেন্ডার করা (যদি হিস্ট্রি থাকে)
    const history = JSON.parse(localStorage.getItem('continue_watching') || '[]');
    if (history.length > 0) {
        const continueDiv = document.createElement('div');
        continueDiv.style.marginBottom = "5px";

        continueDiv.innerHTML = `
            <div class="section-header">
                <div class="section-title-wrapper">
                    <div class="section-bar"></div>
                    <div class="section-title">Continue Watching</div>
                </div>
            </div>
            <div class="horizontal-scroll-container" id="row-continue-watching"></div>
        `;
        container.appendChild(continueDiv);

        const continueRow = continueDiv.querySelector('.horizontal-scroll-container');
        history.forEach(m => renderCard(m, continueRow));
    }

    // ২. বাকি ক্যাটেগরিগুলো রেন্ডার করা (প্রতিটিতে সর্বোচ্চ ১০টি)
    const categories = [...new Set(movies.map(m => m.category).filter(Boolean))];

    categories.forEach(cat => {
        const catMovies = movies.filter(m => m.category === cat);
        if (catMovies.length === 0) return;

        const limitedMovies = catMovies.slice(0, 10);

        const sectionDiv = document.createElement('div');
        sectionDiv.style.marginBottom = "5px";

        sectionDiv.innerHTML = `
            <div class="section-header">
                <div class="section-title-wrapper">
                    <div class="section-bar"></div>
                    <div class="section-title">${cat}</div>
                </div>
                <button class="show-all-btn" onclick="filterMovies('${cat}')">Show All</button>
            </div>
            <div class="horizontal-scroll-container" id="row-${cat.replace(/\s+/g, '_')}"></div>
        `;

        container.appendChild(sectionDiv);

        const rowContainer = sectionDiv.querySelector('.horizontal-scroll-container');
        limitedMovies.forEach(m => renderCard(m, rowContainer));
    });

    homeCachedHTML = container.innerHTML;
}

// ফায়ারবেস লাইভ অ্যাক্টিভ ইউজার কাউন্টার
let currentActive = Math.floor(Math.random() * (482 - 173 + 1)) + 173;
let growthCounter = 0; 

function updateActiveCount() {
    const increaseAmount = Math.floor(Math.random() * 2) + 1; 
    if (growthCounter < 10) {
        currentActive += increaseAmount;
        growthCounter++; 
    } else {
        currentActive -= 2;
        growthCounter = 0; 
    }
    if (currentActive > 482) currentActive = 482; 
    if (currentActive < 173) currentActive = 173;

    const activeSpan = document.getElementById('activeCount');
    if (activeSpan) {
        activeSpan.innerText = currentActive;
    }
}

setInterval(updateActiveCount, 60000);
const activeSpan = document.getElementById('activeCount');
if (activeSpan) {
    activeSpan.innerText = currentActive;
}

checkSubscriptionBackground();
fetchMovies();
